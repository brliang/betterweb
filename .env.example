# Copy to backend/.env for local overrides. Every setting in backend/app/settings.py
# can be set here by its upper-case name.
DATABASE_URL=postgresql+psycopg://discovery:discovery@localhost:5432/discovery
# MAX_EXTERNAL_HOPS=2
# Required before crawling: a real contact page for the bot (docs/PLAN.md §14 Q5).
# Ours is USER_AGENT=bribot/0.1 (+https://github.com/brliang/betterweb/blob/main/docs/bot.md); another deployment names its own page.
# USER_AGENT=bribot/0.1 (+https://your-domain.example/bot)
# One OpenRouter key for embeddings and LLM calls (https://openrouter.ai/settings/keys); set a
# monthly credit limit on the key too. Needed by `cycle run` (the embed stage), `make taxonomy`,
# scripts.describe_topics, search and opt-in summaries.
# OPENROUTER_API_KEY=sk-or-...
# PROVIDER_MONTHLY_SPEND_CAP_USD=40
# A different summary model needs its price (USD per million tokens) in LLM_PRICES.
# SUMMARY_MODEL=anthropic/claude-sonnet-5
# LLM_PRICES={"anthropic/claude-sonnet-5": {"input": 2.0, "output": 10.0}}
# Sign in with `uv run python -m app.worker users login-link you@example.com`. The session
# cookie is HTTPS-only unless this is false (Chrome and Firefox accept it on http://localhost
# anyway; Safari doesn't). ADMIN_EMAILS is a JSON list of who may see /admin.
# SESSION_COOKIE_SECURE=false
# ADMIN_EMAILS=["you@example.com"]
# APP_BASE_URL=http://localhost:5173
# The crawler never connects to loopback or private addresses (docs/PLAN.md §14 Q6). Only for
# a local end-to-end check against a test server on this machine:
# ALLOW_PRIVATE_ADDRESSES=true
# Tests create and drop their own databases; by default DATABASE_URL's name plus `_test`.
# TEST_DATABASE_URL=postgresql+psycopg://discovery:discovery@localhost:5432/discovery_test
