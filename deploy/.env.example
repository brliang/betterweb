# Copy to deploy/.env on the server and `chmod 600` it; docs/DEPLOY.md walks through each value.
# Passwords: generate each with `openssl rand -hex 24` (hex, so they're safe in URLs and JSON).

SITE_ADDRESS=betterweb.example.com
POSTGRES_PASSWORD=
CRAWL_DB_PASSWORD=
SCORE_DB_PASSWORD=
API_DB_PASSWORD=

OPENROUTER_API_KEY=
PROVIDER_MONTHLY_SPEND_CAP_USD=40
USER_AGENT="bribot/0.1 (+https://github.com/brliang/betterweb/blob/main/docs/bot.md)"
# JSON lists of email addresses
ADMIN_EMAILS=["you@example.com"]
ALERT_EMAIL_TO=["you@example.com"]
RESEND_API_KEY=

# When the nightly crawl starts
CYCLE_LOCAL_START=01:00
CYCLE_TIMEZONE=America/New_York

# DigitalOcean Spaces bucket for backups
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
